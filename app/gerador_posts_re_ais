<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>📸 Gerador de Posts Reais | HDMicro</title>
    <style>
        :root { --primary: #e1306c; /* Insta Pink */ --dark: #1a1a1a; --light: #fff; }
        body { font-family: 'Segoe UI', sans-serif; background: var(--dark); color: var(--light); margin: 0; padding: 20px; display: flex; flex-direction: column; align-items: center; min-height: 100vh; }
        
        .container { max-width: 500px; width: 100%; background: #2d2d2d; border-radius: 15px; padding: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
        h2 { text-align: center; color: var(--primary); margin-top: 0; }
        
        label { display: block; margin-bottom: 5px; font-size: 0.9rem; opacity: 0.8; }
        input, select, textarea { width: 100%; padding: 12px; border-radius: 8px; border: 1px solid #444; background: #1a1a1a; color: white; margin-bottom: 15px; box-sizing: border-box; }
        
        /* NOVO: Botão da Câmera Destaque */
        .camera-btn { 
            width: 100%; padding: 15px; background: linear-gradient(45deg, #fd1d1d, #fcb045); 
            color: white; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; 
            font-size: 1.1rem; margin-bottom: 15px; display: flex; justify-content: center; align-items: center; gap: 10px;
            box-shadow: 0 4px 10px rgba(253, 29, 29, 0.3);
        }
        .camera-btn:hover { filter: brightness(1.1); transform: scale(1.02); }
        .upload-alt { text-align: center; font-size: 0.85rem; color: #aaa; margin-bottom: 15px; }
        .upload-link { color: var(--primary); text-decoration: underline; cursor: pointer; }

        .canvas-preview { 
            width: 100%; aspect-ratio: 1/1; background: black; border: 2px dashed #555; 
            display: flex; justify-content: center; align-items: center; margin-bottom: 15px; overflow: hidden; position: relative;
        }
        canvas { max-width: 100%; height: auto; display: none; } 
        
        .btn-action { 
            width: 100%; padding: 15px; background: var(--primary); color: white; border: none; 
            border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 1.1rem; transition: 0.2s;
        }
        .btn-secondary { background: #444; margin-top: 10px; }

        .theme-picker { display: flex; gap: 10px; margin-bottom: 15px; justify-content: center; }
        .theme-dot { width: 30px; height: 30px; border-radius: 50%; cursor: pointer; border: 2px solid transparent; }
        .theme-dot.active { border-color: white; transform: scale(1.1); }
        
        /* Esconde o input file original */
        #fileInput { display: none; }
    </style>
</head>
<body>

<div class="container">
    <h2>📸 Crie Seu Post Viral</h2>
    
    <!-- BOTÃO PRINCIPAL: CÂMERA -->
    <button class="camera-btn" onclick="openCamera()">
        📸 TIRAR FOTO AGORA
    </button>
    
    <!-- OPÇÃO SECUNDÁRIA: UPLOAD DA GALERIA -->
    <div class="upload-alt">
        Ou <span class="upload-link" onclick="document.getElementById('fileInput').click()">Escolher da Galeria</span>
        <input type="file" id="fileInput" accept="image/*" onchange="handleImageUpload(this)">
    </div>

    <label>Título Principal (Grande)</label>
    <input type="text" id="postTitle" placeholder="Ex: SERVIÇO CONCLUÍDO!" maxlength="40">
    
    <label>Subtítulo / Oferta (Médio)</label>
    <textarea id="postSubtitle" rows="2" placeholder="Ex: Instalação elétrica residencial. Orçamento grátis!"></textarea>
    
    <label>Contato / Call to Action (Pequeno)</label>
    <input type="text" id="postContact" placeholder="Ex: WhatsApp: (11) 99999-8888">

    <label>Escolha o Tema Visual:</label>
    <div class="theme-picker">
        <div class="theme-dot active" style="background: linear-gradient(45deg, #833ab4, #fd1d1d, #fcb045);" onclick="setTheme('gradient')"></div>
        <div class="theme-dot" style="background: #1e8449;" onclick="setTheme('green')"></div>
        <div class="theme-dot" style="background: #2c3e50;" onclick="setTheme('blue')"></div>
        <div class="theme-dot" style="background: #000000;" onclick="setTheme('black')"></div>
    </div>

    <div class="canvas-preview" id="previewArea">
        <span style="opacity:0.5;">Tire uma foto ou escolha da galeria</span>
        <canvas id="imgCanvas" width="1080" height="1080"></canvas>
    </div>

    <button class="btn-action" onclick="generateImage()">✅ GERAR IMAGEM HD</button>
    <button class="btn-action btn-secondary" onclick="downloadImage()">💾 BAIXAR PARA O CELULAR</button>
</div>

<script>
let currentTheme = 'gradient';
let loadedImage = null; // Guarda a imagem carregada
const canvas = document.getElementById('imgCanvas');
const ctx = canvas.getContext('2d');

// ============ FUNÇÕES DE CAPTURA DE IMAGEM ============

function openCamera() {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.capture = 'environment'; // Força a câmera TRASEIRA (melhor qualidade para fotos de obras/serviços)
    
    input.onchange = (e) => {
        if (e.target.files && e.target.files[0]) {
            loadImageFromFile(e.target.files[0]);
        }
    };
    input.click();
}

function handleImageUpload(inputElement) {
    if (inputElement.files && inputElement.files[0]) {
        loadImageFromFile(inputElement.files[0]);
    }
}

function loadImageFromFile(file) {
    const reader = new FileReader();
    reader.onload = function(event) {
        const img = new Image();
        img.onload = function() {
            loadedImage = img;
            // Auto-genera a prévia assim que carrega
            generateImage(); 
        };
        img.src = event.target.result;
    };
    reader.readAsDataURL(file);
}

// ============ LÓGICA DE DESENHO (CANVAS) ============

function setTheme(theme) {
    currentTheme = theme;
    document.querySelectorAll('.theme-dot').forEach(d => d.classList.remove('active'));
    event.target.classList.add('active');
    if(loadedImage) generateImage(); // Atualiza se já tiver foto
}

function generateImage() {
    const title = document.getElementById('postTitle').value || "SEU TÍTULO AQUI";
    const subtitle = document.getElementById('postSubtitle').value || "Descreva seu serviço...";
    const contact = document.getElementById('postContact').value || "(00) 00000-0000";
    
    // Limpa canvas
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    // 1. Fundo (Imagem ou Cor Sólida)
    if (loadedImage) {
        // Desenha a imagem cobrindo todo o quadrado (Crop Center)
        drawCoverImage(ctx, loadedImage, 1080, 1080);
        
        // Aplica um overlay escuro semi-transparente para o texto ficar legível sobre a foto
        ctx.fillStyle = "rgba(0, 0, 0, 0.4)";
        ctx.fillRect(0, 0, 1080, 1080);
    } else {
        // Se não tem foto, usa cor sólida/gradiente como antes
        if (currentTheme === 'gradient') {
            let grad = ctx.createLinearGradient(0, 0, 1080, 1080);
            grad.addColorStop(0, "#833ab4");
            grad.addColorStop(0.5, "#fd1d1d");
            grad.addColorStop(1, "#fcb045");
            ctx.fillStyle = grad;
        } else if (currentTheme === 'green') {
            ctx.fillStyle = "#1e8449";
        } else if (currentTheme === 'blue') {
            ctx.fillStyle = "#2c3e50";
        } else {
            ctx.fillStyle = "#000000";
        }
        ctx.fillRect(0, 0, 1080, 1080);
    }

    // 2. Título (Centralizado, Bold, Branco com sombra preta para destacar)
    ctx.shadowColor = "rgba(0,0,0,0.8)";
    ctx.shadowBlur = 10;
    ctx.fillStyle = "#ffffff";
    ctx.font = "bold 80px Arial";
    ctx.textAlign = "center";
    wrapText(ctx, title.toUpperCase(), 540, 350, 900, 90);

    // 3. Subtítulo
    ctx.font = "40px Arial";
    ctx.globalAlpha = 0.9;
    wrapText(ctx, subtitle, 540, 550, 800, 50);
    ctx.globalAlpha = 1.0;

    // 4. Contato (Rodapé, Amarelo Neon)
    ctx.shadowBlur = 5;
    ctx.font = "bold 50px Arial";
    ctx.fillStyle = "#ffff00"; 
    ctx.fillText(contact, 540, 950);
    
    // Remove sombra para próximos desenhos (boa prática)
    ctx.shadowBlur = 0;

    // Mostra o canvas
    canvas.style.display = 'block';
    document.querySelector('#previewArea span').style.display = 'none';
}

// Helper para desenhar imagem cobrindo área sem distorcer (Object-Fit: Cover)
function drawCoverImage(context, image, targetWidth, targetHeight) {
    const ratio = Math.max(targetWidth / image.width, targetHeight / image.height);
    const w = image.width * ratio;
    const h = image.height * ratio;
    const x = (targetWidth - w) / 2;
    const y = (targetHeight - h) / 2;
    context.drawImage(image, x, y, w, h);
}

// Helper para quebrar linhas longas automaticamente
function wrapText(context, text, x, y, maxWidth, lineHeight) {
    const words = text.split(' ');
    let line = '';
    for(let n = 0; n < words.length; n++) {
        const testLine = line + words[n] + ' ';
        const metrics = context.measureText(testLine);
        const testWidth = metrics.width;
        if (testWidth > maxWidth && n > 0) {
            context.fillText(line, x, y);
            line = words[n] + ' ';
            y += lineHeight;
        } else {
            line = testLine;
        }
    }
    context.fillText(line, x, y);
}

function downloadImage() {
    if(!loadedImage && !document.getElementById('postTitle').value) {
        alert("Gere a imagem primeiro!");
        return;
    }
    const link = document.createElement('a');
    link.download = `post_real_${Date.now()}.png`;
    link.href = canvas.toDataURL("image/png");
    link.click();
}
</script>

</body>
</html>
