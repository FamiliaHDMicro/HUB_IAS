<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fiscalize Já | Simples & Direto</title>
    <!-- Lib leve para gerar PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <style>
        :root { --primary: #27ae60; --bg: #f4f7f6; --card: #fff; --text: #2c3e50; --gray: #95a5a6; }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; }
        body { background: var(--bg); color: var(--text); display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
        
        /* HEADER */
        header { background: var(--primary); color: white; padding: 15px; text-align: center; font-weight: bold; font-size: 1.2rem; }
        
        /* CONTEÚDO PRINCIPAL */
        main { flex: 1; overflow-y: auto; padding: 15px; }
        .tab-content { display: none; animation: fadeIn 0.3s; }
        .tab-content.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

        /* FORMULÁRIOS E CARDS */
        .card { background: var(--card); border-radius: 10px; padding: 15px; margin-bottom: 15px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        label { display: block; margin-bottom: 5px; font-size: 0.9rem; color: var(--gray); font-weight: 600; }
        input, select, textarea { width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 6px; font-size: 1rem; margin-bottom: 10px; }
        button { width: 100%; padding: 12px; border: none; border-radius: 6px; font-size: 1rem; font-weight: bold; cursor: pointer; transition: 0.2s; }
        .btn-primary { background: var(--primary); color: white; }
        .btn-secondary { background: #34495e; color: white; margin-top: 5px; }
        .btn-google { background: #4285F4; color: white; }
        
        /* LISTA DE HISTÓRICO */
        .history-item { background: var(--card); padding: 12px; border-radius: 8px; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center; border-left: 4px solid var(--primary); }
        .hist-info h4 { font-size: 0.95rem; margin-bottom: 2px; }
        .hist-info small { color: var(--gray); font-size: 0.8rem; }
        .hist-actions button { width: auto; padding: 5px 10px; font-size: 0.8rem; background: transparent; border: 1px solid #ddd; color: var(--text); }
        .hist-actions button:hover { background: #eee; }

        /* TAB BAR FIXA EMBAIXO */
        nav { background: white; border-top: 1px solid #ddd; display: flex; justify-content: space-around; padding: 10px 0; position: sticky; bottom: 0; z-index: 10; }
        .nav-btn { background: none; border: none; color: var(--gray); font-size: 0.85rem; display: flex; flex-direction: column; align-items: center; gap: 2px; cursor: pointer; width: 33%; }
        .nav-btn.active { color: var(--primary); font-weight: bold; }
        .nav-icon { font-size: 1.5rem; }
        
        /* STATUS MESSAGES */
        .status { font-size: 0.85rem; text-align: center; margin-top: 10px; min-height: 20px; }
        .success { color: var(--primary); }
        .error { color: #e74c3c; }
    </style>
</head>
<body>

<header>💼 Fiscalize Já</header>

<main>
    <!-- ABA 1: NOVO DOCUMENTO -->
    <div id="tab-new" class="tab-content active">
        <div class="card">
            <label>Tipo de Documento</label>
            <select id="docType">
                <option value="nota">Nota de Serviço (Pago)</option>
                <option value="orcamento">Orçamento (Proposta)</option>
            </select>

            <label>Cliente / Empresa</label>
            <input type="text" id="clientName" placeholder="Ex: João da Silva">
            
            <label>WhatsApp (só números + DDD)</label>
            <input type="tel" id="clientPhone" placeholder="11999998888">

            <label>Descrição do Serviço</label>
            <textarea id="serviceDesc" rows="3" placeholder="Detalhe o que foi feito..."></textarea>

            <label>Valor Total (R$)</label>
            <input type="number" id="totalValue" placeholder="0.00" step="0.01">

            <button class="btn-primary" onclick="generateDoc()">✅ Gerar PDF & Enviar Zap</button>
            <div id="genStatus" class="status"></div>
        </div>
    </div>

    <!-- ABA 2: MEUS ARQUIVOS -->
    <div id="tab-history" class="tab-content">
        <div class="card" style="padding: 10px;">
            <h3 style="margin-bottom:10px; font-size:1rem;">Últimos Lançamentos</h3>
            <div id="historyList">
                <p style="text-align:center; color:var(--gray);">Nenhum documento ainda.</p>
            </div>
        </div>
    </div>

    <!-- ABA 3: CONFIGURAÇÃO -->
    <div id="tab-config" class="tab-content">
        <div class="card">
            <h3 style="margin-bottom:10px; font-size:1rem;">Seus Dados Fixos</h3>
            <label>Seu Nome / Razão Social</label>
            <input type="text" id="myName" placeholder="Ex: Maria Souza Serviços">
            
            <label>Seu CPF ou CNPJ</label>
            <input type="text" id="myDoc" placeholder="000.000.000-00">
            
            <button class="btn-secondary" onclick="saveConfig()">💾 Salvar Dados Locais</button>
        </div>

        <div class="card">
            <h3 style="margin-bottom:10px; font-size:1rem;">☁️ Backup Automático (Google Drive)</h3>
            <p style="font-size:0.85rem; color:var(--gray); margin-bottom:10px;">Salva os PDFs numa pasta privada no seu Drive.</p>
            <button class="btn-google" onclick="connectDrive()">🔗 Conectar Conta Google</button>
            <div id="driveStatus" class="status">Não conectado</div>
        </div>
    </div>
</main>

<nav>
    <button class="nav-btn active" onclick="switchTab('new')">
        <span class="nav-icon">📝</span> Novo
    </button>
    <button class="nav-btn" onclick="switchTab('history')">
        <span class="nav-icon">📂</span> Histórico
    </button>
    <button class="nav-btn" onclick="switchTab('config')">
        <span class="nav-icon">⚙️</span> Config
    </button>
</nav>

<script>
// ============ ESTADO GLOBAL ============
let driveToken = sessionStorage.getItem('g_token') || null;
let driveFolderId = null;
const CLIENT_ID = 'SEU_CLIENT_ID_AQUI'; // ⚠️ Configure no Google Cloud Console

// ============ NAVEGAÇÃO ============
function switchTab(tabName) {
    document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.nav-btn').forEach(el => el.classList.remove('active'));
    
    document.getElementById(`tab-${tabName}`).classList.add('active');
    event.currentTarget.classList.add('active');
    
    if(tabName === 'history') renderHistory();
}

// ============ CONFIGURAÇÕES LOCAIS ============
function saveConfig() {
    localStorage.setItem('fy_name', document.getElementById('myName').value);
    localStorage.setItem('fy_doc', document.getElementById('myDoc').value);
    alert("Dados salvos!");
}

window.onload = () => {
    document.getElementById('myName').value = localStorage.getItem('fy_name') || '';
    document.getElementById('myDoc').value = localStorage.getItem('fy_doc') || '';
    checkDriveConnection();
};

// ============ GOOGLE DRIVE INTEGRATION ============
async function connectDrive() {
    if(CLIENT_ID.includes('SEU_')) {
        alert("⚠️ Você precisa configurar o Client ID do Google Cloud primeiro.\nVeja as instruções no README.");
        return;
    }
    const scope = 'https://www.googleapis.com/auth/drive.file';
    window.location.href = `https://accounts.google.com/o/oauth2/v2/auth?client_id=${CLIENT_ID}&redirect_uri=${encodeURIComponent(window.location.origin)}&response_type=token&scope=${scope}`;
}

function checkDriveConnection() {
    const hashParams = new URLSearchParams(location.hash.substring(1));
    const token = hashParams.get('access_token');
    if(token) {
        driveToken = token;
        sessionStorage.setItem('g_token', token);
        history.replaceState(null, "", location.pathname);
        ensureFolderExists();
    }
    updateDriveUI();
}

function updateDriveUI() {
    const statusEl = document.getElementById('driveStatus');
    if(driveToken) {
        statusEl.innerHTML = '<span class="success">✅ Conectado!</span>';
    } else {
        statusEl.innerHTML = '<span class="error">❌ Não conectado</span>';
    }
}

async function ensureFolderExists() {
    try {
        const res = await fetch(`https://www.googleapis.com/drive/v3/files?q=name='Fiscalize_Ja_HDMicro'+and+mimeType='application/vnd.google-apps.folder'`, { headers: { Authorization: `Bearer ${driveToken}` }});
        const data = await res.json();
        if(data.files && data.files.length > 0) {
            driveFolderId = data.files[0].id;
        } else {
            const createRes = await fetch('https://www.googleapis.com/drive/v3/files', {
                method: 'POST', headers: { Authorization: `Bearer ${driveToken}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ name: 'Fiscalize_Ja_HDMicro', mimeType: 'application/vnd.google-apps.folder' })
            });
            driveFolderId = (await createRes.json()).id;
        }
    } catch(e) { console.error(e); }
}

// ============ GERAÇÃO DE DOC ============
async function generateDoc() {
    const type = document.getElementById('docType').value;
    const client = document.getElementById('clientName').value.trim();
    const phone = document.getElementById('clientPhone').value.replace(/\D/g,'');
    const desc = document.getElementById('serviceDesc').value.trim();
    const val = parseFloat(document.getElementById('totalValue').value);
    const myName = localStorage.getItem('fy_name') || "Prestador Autônomo";
    const myDoc = localStorage.getItem('fy_doc') || "";
    const statusEl = document.getElementById('genStatus');

    if(!client || !desc || isNaN(val)) {
        statusEl.textContent = "❌ Preencha Cliente, Descrição e Valor.";
        statusEl.className = "status error";
        return;
    }

    statusEl.textContent = "⏳ Gerando...";
    statusEl.className = "status";

    try {
        // 1. Gera PDF
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        const dateStr = new Date().toLocaleDateString('pt-BR');
        const num = Math.floor(Date.now()/1000).toString().slice(-6);
        const title = type === 'nota' ? 'NOTA DE SERVIÇO' : 'ORÇAMENTO';

        doc.setFontSize(16); doc.setTextColor(39,174,96);
        doc.text(myName, 105, 20, {align:'center'});
        if(myDoc) { doc.setFontSize(10); doc.setTextColor(0); doc.text(`Doc: ${myDoc}`, 105, 26, {align:'center'}); }
        
        doc.setDrawColor(200); doc.line(20, 30, 190, 30);
        doc.setFontSize(14); doc.setTextColor(0);
        doc.text(title, 105, 40, {align:'center'});
        doc.setFontSize(10);
        doc.text(`Nº: ${num} | Data: ${dateStr}`, 105, 48, {align:'center'});
        
        doc.text(`Cliente: ${client}`, 20, 60);
        doc.text(`Serviço: ${desc}`, 20, 70);
        doc.setFont(undefined, 'bold');
        doc.text(`TOTAL: R$ ${val.toFixed(2)}`, 190, 90, {align:'right'});
        doc.setFont(undefined, 'normal');
        doc.text('Gerado por Fiscalize Já', 105, 280, {align:'center', fontSize:8});

        const fileName = `${type}_${num}.pdf`;
        doc.save(fileName); // Baixa no celular/PC

        // 2. Salva no Drive se conectado
        if(driveToken && driveFolderId) {
            await uploadToDrive(doc.output('blob'), fileName);
        }

        // 3. Abre WhatsApp
        const msg = type === 'nota' 
            ? `Olá ${client}! Segue minha Nota de Serviço nº ${num}.\nTotal: R$ ${val.toFixed(2)}`
            : `Olá ${client}! Segue meu Orçamento nº ${num}.\nReferente a: ${desc}\nTotal: R$ ${val.toFixed(2)}`;
        
        if(phone) window.open(`https://wa.me/${phone}?text=${encodeURIComponent(msg)}`, '_blank');

        // 4. Registra no Histórico Local
        addToHistory({ type, client, val, date: dateStr, num });
        
        statusEl.textContent = "✅ Sucesso! PDF baixado e Zap aberto.";
        statusEl.className = "status success";
        
        // Limpa campos parciais
        document.getElementById('clientName').value = '';
        document.getElementById('clientPhone').value = '';
        document.getElementById('serviceDesc').value = '';
        document.getElementById('totalValue').value = '';

    } catch(e) {
        statusEl.textContent = "❌ Erro: " + e.message;
        statusEl.className = "status error";
    }
}

async function uploadToDrive(blob, fileName) {
    const form = new FormData();
    form.append('metadata', new Blob([JSON.stringify({ name: fileName, parents: [driveFolderId] })], { type: 'application/json' }));
    form.append('file', blob);
    await fetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart', {
        method: 'POST', headers: { Authorization: `Bearer ${driveToken}` }, body: form
    });
}

// ============ HISTÓRICO LOCAL ============
function addToHistory(item) {
    let hist = JSON.parse(localStorage.getItem('fy_hist') || '[]');
    hist.unshift(item);
    if(hist.length > 20) hist.pop();
    localStorage.setItem('fy_hist', JSON.stringify(hist));
}

function renderHistory() {
    const list = document.getElementById('historyList');
    const hist = JSON.parse(localStorage.getItem('fy_hist') || '[]');
    if(hist.length === 0) {
        list.innerHTML = '<p style="text-align:center; color:var(--gray);">Nenhum documento ainda.</p>';
        return;
    }
    list.innerHTML = hist.map(h => `
        <div class="history-item">
            <div class="hist-info">
                <h4>${h.client}</h4>
                <small>${h.date} • Nº ${h.num} • ${h.type === 'nota' ? 'Nota' : 'Orç.'}</small>
            </div>
            <div class="hist-actions">
                <strong>R$ ${h.val.toFixed(2)}</strong>
            </div>
        </div>
    `).join('');
}
</script>
</body>
</html>
