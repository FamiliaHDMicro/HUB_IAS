<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>SoCialBR | Sua Rede, Suas Regras</title>
    <!-- Fonte Leve -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;800&display=swap" rel="stylesheet">
    
    <style>
        /* ==========================================
           SISTEMA DE TEMAS (BASEADO NO SEU SCHEMA)
           ========================================== */
        :root {
            /* Tema Padrão: Zumbi (Roxo/Limão) */
            --bg: #1a1030;
            --painel: #2c1e4f;
            --cabeca: #3a2a64;
            --titulo: #d6ff00;
            --btn: #d6ff00;
            --linha: #5a4a84;
            --acento: #d6ff00;
            --texto: #d9c6ff;
            --raio: 26px;
            --fonte: 'Poppins', sans-serif;
        }

        /* Tema Kawaii (Unicórnio) */
        body[data-theme="kawaii"] {
            --bg: #ffedf7; --painel: #ffffff; --cabeca: #ff8fcd; 
            --titulo: #7b4dff; --btn: #ff8fcd; --linha: #b8e6ff; 
            --acento: #7b4dff; --texto: #6b3d5e; --raio: 32px;
        }

        /* Tema Gamer (Cyberpunk) */
        body[data-theme="gamer"] {
            --bg: #000000; --painel: #0f0f0f; --cabeca: #ff00e5; 
            --titulo: #00fff0; --btn: #ff00e5; --linha: #00fff0; 
            --acento: #ffe600; --texto: #00ff9a; --raio: 0px;
        }

        /* Tema Brasil (Natureza) */
        body[data-theme="brasil"] {
            --bg: #eef6e2; --painel: #ffffff; --cabeca: #009739; 
            --titulo: #002776; --btn: #009739; --linha: #ffdf00; 
            --acento: #ffdf00; --texto: #0a2a12; --raio: 22px;
        }

        /* Estilos Globais */
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: var(--fonte); transition: background-color 0.3s, color 0.3s, border-color 0.3s; }
        body { background: var(--bg); color: var(--texto); height: 100vh; display: flex; flex-direction: column; overflow: hidden; }
        
        /* Header */
        header { background: var(--painel); padding: 15px; border-bottom: 2px solid var(--linha); display: flex; justify-content: space-between; align-items: center; z-index: 10; }
        .logo { font-weight: 800; font-size: 1.2rem; color: var(--titulo); text-transform: uppercase; letter-spacing: -1px; }
        .theme-switcher { display: flex; gap: 5px; }
        .dot { width: 20px; height: 20px; border-radius: 50%; cursor: pointer; border: 2px solid transparent; }
        .dot.active { border-color: white; transform: scale(1.2); }

        /* Main Content Area */
        main { flex: 1; overflow-y: auto; padding: 20px; padding-bottom: 80px; position: relative; }
        
        /* Cards de Comunidade/Grupo */
        .card { background: var(--painel); border: 1px solid var(--linha); border-radius: var(--raio); padding: 15px; margin-bottom: 15px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
        .group-name { font-weight: bold; color: var(--titulo); font-size: 1.1rem; }
        .member-count { font-size: 0.8rem; opacity: 0.7; background: var(--cabeca); color: white; padding: 2px 8px; border-radius: 10px; }
        
        /* Feed de Posts */
        .post { border-top: 1px dashed var(--linha); padding-top: 10px; margin-top: 10px; }
        .post-author { font-weight: 600; color: var(--acento); font-size: 0.9rem; }
        .post-text { margin-top: 5px; line-height: 1.4; }
        .post-time { font-size: 0.7rem; opacity: 0.5; margin-top: 5px; }

        /* Input de Novo Post */
        .composer { position: fixed; bottom: 60px; left: 0; right: 0; background: var(--painel); padding: 15px; border-top: 1px solid var(--linha); display: none; /* Escondido por padrão */ }
        .composer textarea { width: 100%; background: var(--bg); border: 1px solid var(--linha); color: var(--texto); padding: 10px; border-radius: 8px; resize: none; outline: none; }
        .composer button { background: var(--btn); color: var(--bg); border: none; padding: 10px 20px; border-radius: 8px; font-weight: bold; margin-top: 10px; cursor: pointer; width: 100%; }

        /* Bottom Nav Bar */
        nav { position: fixed; bottom: 0; left: 0; width: 100%; background: var(--painel); border-top: 2px solid var(--linha); display: flex; justify-content: space-around; padding: 10px 0 calc(10px + env(safe-area-inset-bottom)); z-index: 20; }
        .nav-item { display: flex; flex-direction: column; align-items: center; color: var(--texto); opacity: 0.6; font-size: 0.7rem; cursor: pointer; }
        .nav-item.active { opacity: 1; color: var(--acento); }
        .nav-icon { font-size: 1.5rem; margin-bottom: 2px; }

        /* Botão Flutuante (+) */
        .fab { position: absolute; bottom: 70px; right: 20px; width: 50px; height: 50px; background: var(--acento); color: var(--bg); border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 24px; font-weight: bold; box-shadow: 0 4px 10px rgba(0,0,0,0.3); cursor: pointer; z-index: 15; border: none; }

        /* Modal Simples */
        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); display: none; justify-content: center; align-items: center; z-index: 100; backdrop-filter: blur(3px); }
        .modal-content { background: var(--painel); padding: 20px; border-radius: var(--raio); width: 90%; max-width: 400px; border: 1px solid var(--linha); }
        .modal-title { color: var(--titulo); margin-bottom: 15px; font-size: 1.2rem; }
        .input-group { margin-bottom: 10px; }
        .input-group label { display: block; font-size: 0.8rem; margin-bottom: 5px; opacity: 0.8; }
        .input-group input, .input-group select { width: 100%; padding: 10px; background: var(--bg); border: 1px solid var(--linha); color: var(--texto); border-radius: 8px; }
        .btn-primary { background: var(--btn); color: var(--bg); border: none; padding: 12px; width: 100%; border-radius: 8px; font-weight: bold; cursor: pointer; margin-top: 10px; }
        .btn-cancel { background: transparent; color: var(--texto); border: 1px solid var(--linha); padding: 12px; width: 100%; border-radius: 8px; cursor: pointer; margin-top: 5px; }

    </style>
</head>
<body data-theme="zumbi">

<header>
    <div class="logo">SoCialBR</div>
    <div class="theme-switcher">
        <div class="dot active" style="background:#d6ff00;" onclick="setTheme('zumbi')" title="Zumbi"></div>
        <div class="dot" style="background:#ff8fcd;" onclick="setTheme('kawaii')" title="Kawaii"></div>
        <div class="dot" style="background:#00fff0;" onclick="setTheme('gamer')" title="Gamer"></div>
        <div class="dot" style="background:#009739;" onclick="setTheme('brasil')" title="Brasil"></div>
    </div>
</header>

<main id="feedContainer">
    <!-- Os posts serão injetados aqui via JavaScript -->
    <div style="text-align:center; padding:40px; opacity:0.5;">
        Carregando comunidades...<br>
        <small>(Conectando ao Worker...)</small>
    </div>
</main>

<!-- Composer de Post (Escondido até clicar no +) -->
<div class="composer" id="postComposer">
    <textarea id="newPostText" placeholder="O que tá rolando hoje?" rows="3"></textarea>
    <button onclick="publishPost()">Publicar 🔥</button>
    <button class="btn-cancel" onclick="toggleComposer(false)" style="margin-top:5px;">Cancelar</button>
</div>

<!-- Botão Flutuante -->
<button class="fab" onclick="toggleComposer(true)">+</button>

<nav>
    <div class="nav-item active" onclick="switchTab('home')">
        <span class="nav-icon">🏠</span>
        <span>Início</span>
    </div>
    <div class="nav-item" onclick="openModal('createGroup')">
        <span class="nav-icon">➕</span>
        <span>Criar</span>
    </div>
    <div class="nav-item" onclick="alert('Perfil em construção!')">
        <span class="nav-icon">👤</span>
        <span>Perfil</span>
    </div>
</nav>

<!-- Modais -->
<div class="modal-overlay" id="modalCreateGroup">
    <div class="modal-content">
        <h3 class="modal-title">Nova Comunidade 🌱</h3>
        <div class="input-group">
            <label>Nome do Grupo</label>
            <input type="text" id="groupNameInput" placeholder="Ex: Mutirão Centro">
        </div>
        <div class="input-group">
            <label>Tipo de Acesso</label>
            <select id="groupTypeSelect">
                <option value="aberto">Aberto (Qualquer um entra)</option>
                <option value="fechado">Fechado (Só convite)</option>
            </select>
        </div>
        <button class="btn-primary" onclick="createNewGroup()">Criar Agora</button>
        <button class="btn-cancel" onclick="closeModal()">Fechar</button>
    </div>
</div>

<script>
// ============ CONFIGURAÇÃO DA API ============
const API_URL = 'https://SEU-WORKER-SOCIALBR.workers.dev'; // SUBSTITUA PELA URL REAL DO SEU WORKER
let currentUserToken = localStorage.getItem('soc_br_token'); // Token salvo após login

// Estado Local
let groups = [];
let currentGroupId = null;

// ============ INICIALIZAÇÃO ============
document.addEventListener('DOMContentLoaded', () => {
    initApp();
});

async function initApp() {
    if (!currentUserToken) {
        // Redireciona para tela de login/cadastro simples
        alert("Faça login primeiro!");
        return;
    }
    await loadGroups();
}

// ============ LÓGICA DE TEMAS ============
function setTheme(themeName) {
    document.body.setAttribute('data-theme', themeName);
    
    // Atualiza dots visuais
    document.querySelectorAll('.dot').forEach(d => d.classList.remove('active'));
    event.target.classList.add('active');

    // Salva preferência localmente
    localStorage.setItem('soc_br_theme', themeName);
    
    // TODO: Enviar para API para salvar no perfil do usuário (endpoint /api/settings)
}

// ============ CARREGAMENTO DE DADOS (API REAL) ============
async function loadGroups() {
    try {
        const res = await fetch(`${API_URL}/api/grupos`, {
            headers: { 'Authorization': `Bearer ${currentUserToken}` }
        });
        const data = await res.json();
        
        if (Array.isArray(data)) {
            groups = data;
            renderFeed();
        } else {
            console.error("Erro ao carregar grupos:", data);
        }
    } catch (e) {
        console.error("Falha de conexão com Worker:", e);
        document.getElementById('feedContainer').innerHTML = `<p style="color:red; text-align:center;">Erro de conexão. Verifique o Worker.</p>`;
    }
}

function renderFeed() {
    const container = document.getElementById('feedContainer');
    if (groups.length === 0) {
        container.innerHTML = `<div style="text-align:center; padding:20px;"><p>Nenhuma comunidade ainda.<br>Clique em '+' para criar!</p></div>`;
        return;
    }

    container.innerHTML = groups.map(g => `
        <div class="card" onclick="selectGroup('${g.id}')">
            <div class="card-header">
                <span class="group-name">${g.nome}</span>
                <span class="member-count">${g.membros || '?'} membros</span>
            </div>
            <div style="font-size:0.85rem; opacity:0.8;">
                Status: ${g.status} • Tipo: ${g.tipo || 'aberto'}
            </div>
            <!-- Último post simulado -->
            <div class="post">
                <div class="post-author">@usuario_demo</div>
                <div class="post-text">Bem-vindo à nova era das redes sociais privadas!</div>
                <div class="post-time">há 2 horas</div>
            </div>
        </div>
    `).join('');
}

// ============ INTERAÇÕES USUÁRIO ============
function toggleComposer(show) {
    const composer = document.getElementById('postComposer');
    const fab = document.querySelector('.fab');
    
    if (show) {
        composer.style.display = 'block';
        fab.style.display = 'none';
        document.getElementById('newPostText').focus();
    } else {
        composer.style.display = 'none';
        fab.style.display = 'flex';
    }
}

async function publishPost() {
    const text = document.getElementById('newPostText').value.trim();
    if (!text || !currentGroupId) return;

    // Envia para API Real
    try {
        const res = await fetch(`${API_URL}/api/grupos/${currentGroupId}/posts`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${currentUserToken}`
            },
            body: JSON.stringify({ texto: text })
        });
        
        const result = await res.json();
        if (result.ok) {
            alert("Post publicado!");
            document.getElementById('newPostText').value = '';
            toggleComposer(false);
            // Recarrega feed ou adiciona localmente
        } else {
            throw new Error(result.erro);
        }
    } catch (e) {
        alert("Erro ao publicar: " + e.message);
    }
}

function openModal(type) {
    if (type === 'createGroup') {
        document.getElementById('modalCreateGroup').style.display = 'flex';
    }
}

function closeModal() {
    document.querySelectorAll('.modal-overlay').forEach(m => m.style.display = 'none');
}

async function createNewGroup() {
    const nome = document.getElementById('groupNameInput').value;
    const tipo = document.getElementById('groupTypeSelect').value;
    
    if (!nome) return alert("Dê um nome ao grupo!");

    try {
        const res = await fetch(`${API_URL}/api/grupos`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${currentUserToken}`
            },
            body: JSON.stringify({ nome, tipo })
        });
        
        const data = await res.json();
        if (data.id) {
            alert("Grupo criado com sucesso!");
            closeModal();
            await loadGroups(); // Recarrega lista
        } else {
            throw new Error(data.erro);
        }
    } catch (e) {
        alert("Erro: " + e.message);
    }
}

function selectGroup(id) {
    currentGroupId = id;
    // Aqui você poderia navegar para uma tela específica do grupo
    // Por simplicidade, vamos assumir que o feed mostra todos, 
    // mas o botão "+" publica no último selecionado ou pede confirmação.
    alert(`Selecionou o grupo: ${id}. Use o botão + para postar nele.`);
}

function switchTab(tab) {
    // Lógica simples de navegação
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    event.currentTarget.classList.add('active');
    
    if(tab === 'home') {
        loadGroups();
    }
}
</script>

</body>
</html>
