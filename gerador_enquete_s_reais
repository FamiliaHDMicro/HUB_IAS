<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🗳️ Gerador de Enquetes Reais | HDMicro</title>
    <style>
        :root { --wa-green: #25D366; --bg: #f0f2f5; }
        body { font-family: 'Segoe UI', sans-serif; background: var(--bg); margin: 0; padding: 20px; color: #333; }
        .container { max-width: 500px; margin: 0 auto; background: white; padding: 20px; border-radius: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
        h2 { color: var(--wa-green); text-align: center; margin-top: 0; }
        
        .form-group { margin-bottom: 15px; }
        label { display: block; font-weight: bold; margin-bottom: 5px; font-size: 0.9rem; }
        input, select { width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 8px; box-sizing: border-box; }
        
        .options-list { background: #f9f9f9; padding: 10px; border-radius: 8px; margin-top: 10px; }
        .option-row { display: flex; gap: 10px; margin-bottom: 5px; }
        .option-input { flex: 1; }
        .remove-btn { background: #ff4757; color: white; border: none; border-radius: 5px; padding: 0 10px; cursor: pointer; }
        
        .preview-box { 
            background: #e7ffc6; border-left: 4px solid var(--wa-green); padding: 15px; margin: 20px 0; 
            font-family: monospace; white-space: pre-wrap; word-break: break-word; min-height: 100px;
            border-radius: 0 10px 10px 0; position: relative;
        }
        .copy-hint { position: absolute; top: -10px; right: 10px; background: var(--wa-green); color: white; padding: 2px 8px; border-radius: 10px; font-size: 0.7rem; }
        
        .btn-copy { 
            width: 100%; padding: 15px; background: var(--wa-green); color: white; border: none; 
            border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 1.1rem;
        }
        .btn-add-opt { background: #eee; color: #333; border: 1px dashed #ccc; width: 100%; padding: 10px; margin-top: 5px; cursor: pointer; border-radius: 5px; }
    </style>
</head>
<body>

<div class="container">
    <h2>🗳️ Monte Sua Enquete</h2>
    
    <div class="form-group">
        <label>Pergunta da Enquete</label>
        <input type="text" id="pollQuestion" placeholder="Ex: Quem precisa de orçamento hoje?" oninput="updatePreview()">
    </div>

    <div class="form-group">
        <label>Opções de Resposta</label>
        <div class="options-list" id="optionsContainer">
            <!-- Opções geradas via JS -->
        </div>
        <button class="btn-add-opt" onclick="addOption()">➕ Adicionar Mais Uma Opção</button>
    </div>

    <div class="preview-box" id="previewBox">
        <span class="copy-hint">Copie isto 👇</span>
        <div id="previewContent">Preencha acima para ver o formato...</div>
    </div>

    <button class="btn-copy" onclick="copyToClipboard()">📋 COPIAR TEXTO PRONTO</button>
    <p style="font-size:0.8rem; color:#666; text-align:center; margin-top:10px;">
        Cole no Status do WhatsApp, Groups ou Stories.
    </p>
</div>

<script>
let optionsCount = 2; // Começa com 2 opções padrão

window.onload = () => {
    addOption("Sim, preciso!");
    addOption("Não, obrigado.");
    updatePreview();
};

function addOption(defaultVal = "") {
    const container = document.getElementById('optionsContainer');
    const div = document.createElement('div');
    div.className = 'option-row';
    div.innerHTML = `
        <input type="text" class="option-input" value="${defaultVal}" placeholder="Opção ${optionsCount}" oninput="updatePreview()">
        <button class="remove-btn" onclick="this.parentElement.remove(); updatePreview();">X</button>
    `;
    container.appendChild(div);
    optionsCount++;
}

function updatePreview() {
    const question = document.getElementById('pollQuestion').value || "Sua pergunta aqui?";
    const inputs = document.querySelectorAll('.option-input');
    let opts = [];
    
    inputs.forEach(inp => {
        if(inp.value.trim()) opts.push(`• ${inp.value.trim()}`);
    });

    if(opts.length === 0) opts.push("• Opção 1", "• Opção 2");

    // Formata para WhatsApp (negrito com asteriscos, lista com bullets)
    const formattedText = `*${question}*\n\n${opts.join('\n')}\n\n_Responda por aqui!_`;
    
    document.getElementById('previewContent').innerText = formattedText;
}

function copyToClipboard() {
    const text = document.getElementById('previewContent').innerText;
    
    // Tenta usar a API moderna de clipboard
    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(() => {
            alert("✅ Copiado! Agora cole no WhatsApp.");
        }).catch(err => {
            console.error('Erro ao copiar:', err);
            fallbackCopy(text);
        });
    } else {
        // Fallback para navegadores mais antigos ou contextos inseguros
        fallbackCopy(text);
    }
}

function fallbackCopy(text) {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    document.body.appendChild(textarea);
    textarea.select();
    try {
        document.execCommand('copy');
        alert("✅ Copiado! Agora cole no WhatsApp.");
    } catch (err) {
        alert("❌ Erro ao copiar. Selecione o texto manualmente.");
    }
    document.body.removeChild(textarea);
}
</script>

</body>
</html>
